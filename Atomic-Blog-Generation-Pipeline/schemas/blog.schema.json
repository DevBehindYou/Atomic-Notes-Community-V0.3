{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Atomic Notes blog frontmatter",
  "type": "object",
  "required": [
    "title", "slug", "description", "excerpt", "author",
    "publishedAt", "category", "tags", "draft", "coverImage",
    "coverAlt", "canonical", "keywords", "readingTime"
  ],
  "properties": {
    "title": { "type": "string", "minLength": 1, "maxLength": 70 },
    "slug": { "type": "string", "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$" },
    "description": { "type": "string", "minLength": 80, "maxLength": 170 },
    "excerpt": { "type": "string", "minLength": 1 },
    "author": { "type": "string", "minLength": 1 },
    "publishedAt": { "type": "string" },
    "updatedAt": { "type": "string" },
    "category": {
      "type": "string",
      "enum": [
        "development", "releases", "privacy", "security", "local-first",
        "open-source", "engineering", "atomic-energy", "community", "announcements"
      ]
    },
    "tags": { "type": "array", "items": { "type": "string" }, "minItems": 1 },
    "featured": { "type": "boolean" },
    "draft": { "type": "boolean" },
    "coverImage": { "type": "string", "minLength": 1 },
    "coverAlt": { "type": "string", "minLength": 1 },
    "canonical": { "type": "string", "pattern": "^https?://" },
    "keywords": { "type": "string", "minLength": 1 },
    "readingTime": { "type": "string", "minLength": 1 }
  }
}
