# Copy to .env.local (never commit real values). In Vercel, set these as
# Project Settings > Environment Variables.

# The Atomic Notes Server — same backend the App talks to.
ATOMIC_SERVER_URL=https://atomic-notes-server-gde2e.vercel.app

# SERVER-ONLY. Matches the Server's own ADMIN_API_KEY (see that project's
# .env.example) — used only inside server route handlers here, never sent to
# the browser. Do NOT prefix it with NEXT_PUBLIC_.
ADMIN_API_KEY=same-value-as-the-servers-ADMIN_API_KEY

# Secret Atomic-Controller admin panel gate. TWO keys — both are required to log
# in (two-screen login). Use two different strong values.
ADMIN_PASSWORD=choose-a-strong-first-key
ADMIN_PASSWORD_2=choose-a-different-strong-second-key
# HMAC secret used to sign the admin session cookie. Use a long random string.
SESSION_SECRET=change-me-to-a-long-random-string

# Public download link shown on the community site (GitHub release APK).
NEXT_PUBLIC_APK_URL=https://github.com/DevBehindYou/Atomic-Notes-App/releases/latest

NEXT_PUBLIC_SITE_URL=https://atomic-notes-community.vercel.app
